<Page
    x:Class="winui.LicensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Click="BackButton_Click" Width="40" Height="32">
                <SymbolIcon Symbol="Back"/>
            </Button>
            <TextBlock Text="MIT License" Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontSize="13"
                       FontFamily="Consolas" LineHeight="22"/>
        </ScrollViewer>
    </Grid>
</Page>