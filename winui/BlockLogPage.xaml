<Page
    x:Class="winui.BlockLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="16">
        <TextBlock Text="拦截日志" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="刷新" Click="Refresh_Click"/>
            <Button Content="清空" Click="Clear_Click"/>
            <Button Content="导出训练数据" Click="ExportSamples_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="FilterCombo" SelectionChanged="Filter_Changed" Width="160" SelectedIndex="0">
                <ComboBoxItem Content="全部日志" Tag="all"/>
                <ComboBoxItem Content="命中黑/白名单" Tag="list"/>
                <ComboBoxItem Content="ML与启发冲突" Tag="ml_heur"/>
                <ComboBoxItem Content="ML与名单冲突" Tag="ml_list"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索 (exe/标题/类名)" Width="300" TextChanged="Search_Changed"/>
            <TextBlock x:Name="FilterCountText" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Text="0 / 0 条"/>
        </StackPanel>

        <ListView x:Name="LogList" Height="420" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap"
                               FontSize="12" FontFamily="Consolas"
                               RightTapped="LogItem_RightTapped">
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="标记为弹窗（拦截正确）" Click="MarkPopup_Click"/>
                                <MenuFlyoutItem Text="标记为误关（非弹窗）" Click="MarkNotPopup_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="添加到黑名单" Click="AddToBlacklist_Click"/>
                                <MenuFlyoutItem Text="添加到白名单" Click="AddToWhitelist_Click"/>
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock FontSize="12" Foreground="Gray"
                   Text="记录每次拦截：时间、命中规则、窗口标题 / 类名 / 进程。最新在上。右键条目可标记用于训练数据导出。"/>
    </StackPanel>
</Page>