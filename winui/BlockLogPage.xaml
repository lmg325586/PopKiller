<Page
    x:Class="winui.BlockLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">

        <TextBlock Grid.Row="0" Text="拦截日志" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="刷新" Click="Refresh_Click"/>
            <Button Content="清空" Click="Clear_Click"/>
            <Button Content="导出训练数据" Click="ExportSamples_Click"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="FilterCombo" SelectionChanged="Filter_Changed" Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="全部日志" Tag="all"/>
                    <ComboBoxItem Content="命中黑/白名单" Tag="list"/>
                    <ComboBoxItem Content="ML与启发冲突" Tag="ml_heur"/>
                    <ComboBoxItem Content="ML与名单冲突" Tag="ml_list"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索 (exe/标题/类名)" Width="300" TextChanged="Search_Changed"/>
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="FilterCountText" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Text="0 / 0 条"/>
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="LogList" SelectionMode="None" Loaded="OnLogListLoaded"/>

            <Button x:Name="NewLogJumpButton" Content="↑ 有新日志"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                    Visibility="Collapsed" Click="NewLogJumpButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>

        <TextBlock Grid.Row="4" FontSize="12" Foreground="Gray"
                   Text="同进程事件自动合并，双击展开单次明细（最近 100 条）。右键条目可标记或加规则。"/>
    </Grid>
</Page>