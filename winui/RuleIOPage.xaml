<Page
    x:Class="winui.RuleIOPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,0">
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left" Padding="0,24">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="BackButton_Click" Padding="8,6">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <TextBlock Text="导入导出规则" Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="导出规则" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="选择要导出的内容并保存为 JSON 文件，用于备份或分享给他人。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ExportCommunityRules" Content="包含社区规则" IsChecked="True"/>
                    <CheckBox x:Name="ExportTombstones" Content="包含已禁用的社区规则（墓碑记录）" IsChecked="True"/>

                    <Button Content="选择保存位置…" Click="ExportButton_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="导入规则" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="选择规则 JSON 文件，与现有规则合并；重复规则自动跳过，导入后保存为本地规则。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <Button Content="选择规则文件…" Click="ImportButton_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ResultText" Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>