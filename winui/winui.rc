#include <windows.h>

// Version resource template. FILEVERSION / PRODUCTVERSION and
// FileVersion / ProductVersion values are rewritten before build by
// scripts/GenerateVersion.ps1 (this file is marked git skip-worktree).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PopKiller"
            VALUE "FileDescription", "PopKiller - popup blocker"
            VALUE "FileVersion", "0.0.0.0"
            VALUE "InternalName", "winui"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "winui.exe"
            VALUE "ProductName", "PopKiller"
            VALUE "ProductVersion", "0.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
