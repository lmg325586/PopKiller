<Page
    x:Class="winui.PopupBlockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="16">
        <TextBlock Text="弹窗拦截" Style="{StaticResource TitleTextBlockStyle}"/>

        <ToggleSwitch x:Name="EnableToggle" Header="启用弹窗拦截"
                      OnContent="开" OffContent="关"
                      Toggled="EnableToggle_Toggled"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="RuleTypeCombo" SelectedIndex="0" Width="90">
                <ComboBoxItem Content="进程"/>
                <ComboBoxItem Content="标题"/>
                <ComboBoxItem Content="类名"/>
            </ComboBox>
            <TextBox x:Name="PatternInput" Width="260"
                     PlaceholderText="如 xxx.exe 或标题关键字"/>
            <Button Content="添加" Click="AddRule_Click"/>
        </StackPanel>

        <ListView x:Name="RulesList" Height="240"/>

        <Button Content="删除选中规则" Click="DeleteRule_Click"/>

        <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                   Text="进程=exe 名子串；标题=窗口标题子串；类名=窗口类名子串。规则保存在注册表，拦截引擎将在后续版本接入。"/>
    </StackPanel>
</Page>