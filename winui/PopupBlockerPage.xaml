<Page
    x:Class="winui.PopupBlockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,0">
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left" Padding="0,24">

            <TextBlock Text="弹窗拦截"
                       Style="{StaticResource TitleTextBlockStyle}"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="8">

                    <TextBlock Text="拦截状态"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="EnableToggle"
                                  Header="启用弹窗拦截"
                                  OnContent="开" OffContent="关"
                                  Toggled="EnableToggle_Toggled"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="社区规则库"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="CommunityRulesToggle"
                                  Header="启用社区规则库"
                                  OnContent="开" OffContent="关"
                                  Toggled="CommunityRulesToggle_Toggled"/>

                    <TextBlock Text="启动时自动从 GitHub 拉取最新社区规则，与本地规则合并生效，离线时使用上次缓存。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="CommunityStatusText" Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RetryFetchButton" Content="重试"
                                Visibility="Collapsed"
                                Click="RetryFetchButton_Click"
                                Padding="12,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="添加规则"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ListTypeCombo" SelectedIndex="0" MinWidth="90">
                            <ComboBoxItem Content="黑名单"/>
                            <ComboBoxItem Content="白名单"/>
                        </ComboBox>
                        <ComboBox x:Name="RuleTypeCombo" SelectedIndex="0" MinWidth="80">
                            <ComboBoxItem Content="进程"/>
                            <ComboBoxItem Content="路径"/>
                            <ComboBoxItem Content="标题"/>
                            <ComboBoxItem Content="类名"/>
                        </ComboBox>
                        <ComboBox x:Name="MatchModeCombo" SelectedIndex="0" MinWidth="80">
                            <ComboBoxItem Content="包含"/>
                            <ComboBoxItem Content="精确"/>
                            <ComboBoxItem Content="通配符"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="PatternInput"
                                 PlaceholderText="如 *pop* 或完整路径"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="200"/>

                        <Button x:Name="AddRuleButton" Content="添加" Click="AddRule_Click"/>
                        <Button Content="选取窗口" Click="Pick_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="PickInfo" Text=""
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="规则列表"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>

                        <Button Content="导入导出" Click="OpenIO_Click" Padding="12,4" Grid.Column="1"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="编辑选中" Click="EditRule_Click" Padding="12,4"/>
                        <Button Content="删除选中" Click="DeleteRule_Click" Padding="12,4"/>
                    </StackPanel>

                    <TextBox x:Name="SearchInput"
                             PlaceholderText="搜索规则"
                             TextChanged="SearchInput_TextChanged"/>
                    <ListView x:Name="RulesList" Height="260"/>
                </StackPanel>
            </Border>

            <TextBlock Text="支持黑名单拦截与白名单放行，白名单优先级更高。匹配模式支持包含（子串）、精确（全等）、通配符（支持 * 和 ?）。所有规则自动保存到程序同目录的 rules.json。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</Page>