<Page
    x:Class="winui.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE713;" FontSize="20" FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                      Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="主题材质" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeComboBox" Width="150"
                      SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="默认"/>
                <ComboBoxItem Content="Mica"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE72E;" FontSize="20" FontFamily="{ThemeResource SymbolThemeFontFamily}" 
              Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
            <TextBlock Text="弹窗拦截设置" Style="{StaticResource TitleTextBlockStyle}"/>
        </StackPanel>

        <ToggleSwitch x:Name="ForceBlockToggle"
              Header="规则内是否一律拦截"
              OffContent="当前:仅拦弹窗形态 (推荐)" OnContent="当前:命中即拦"
              Toggled="ForceBlockToggle_Toggled"
              Margin="0,16,0,0"/>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="启发式拦截（实验性）" VerticalAlignment="Center"/>
            <ComboBox x:Name="HeuristicModeCombo" SelectedIndex="0" Width="120"
                      SelectionChanged="HeuristicModeCombo_SelectionChanged">
                <ComboBoxItem Content="关闭"/>
                <ComboBoxItem Content="启用"/>
                <ComboBoxItem Content="仅记录"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Text="根据窗口特征自动识别未知弹窗。启用=超阈值自动拦截；仅记录=只写日志不拦截。"
                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,-8,0,16"/>

        <StackPanel Spacing="12">
            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBlock FontSize="14">
                <Run Text="作者：" />
                <Hyperlink NavigateUri="https://github.com/">
                    <Run Text="Lmg325586" />
                </Hyperlink>
                <Run Text="   开发:Qwen-3.8-max   DeepSeek-V3.1" />
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock FontSize="14" Text="许可证："/>
                <HyperlinkButton Content="MIT License" FontWeight="SemiBold"
                     Padding="0" Margin="0,-4,0,0"
                     Click="LicenseLink_Click"/>
            </StackPanel>

            <TextBlock FontSize="14">
                <Run Text="版本：" />
                <Run Text="Beta 0.1" />
            </TextBlock>
        </StackPanel>
    </StackPanel>
</Page>