<Page
    x:Class="winui.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="16">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="主题材质" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeComboBox" Width="150"
                    SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="默认"/>
                <ComboBoxItem Content="Mica"/>
            </ComboBox>
        </StackPanel>
    </StackPanel>
</Page>