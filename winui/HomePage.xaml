<Page
    x:Class="winui.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16">

            <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}"/>


            <Border x:Name="GlowCard"
                    Background="Transparent"
                    HorizontalAlignment="Left"
                    MaxWidth="800"
                    PointerEntered="GlowPointerEntered"
                    PointerMoved="GlowPointerMoved"
                    PointerExited="GlowPointerExited">
                <Grid>

                    <Canvas x:Name="GlowCanvas" Opacity="0" IsHitTestVisible="False">

                        <Ellipse x:Name="GlowLayer5" Width="240" Height="240" Fill="#19D9D9D9"/>
                        <Ellipse x:Name="GlowLayer4" Width="200" Height="200" Fill="#26D9D9D9"/>
                        <Ellipse x:Name="GlowLayer3" Width="160" Height="160" Fill="#40D9D9D9"/>
                        <Ellipse x:Name="GlowLayer2" Width="120" Height="120" Fill="#59D9D9D9"/>
                        <Ellipse x:Name="GlowLayer1" Width="80"  Height="80"  Fill="#73D9D9D9"/>
                    </Canvas>


                    <Border Background="White"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Margin="2">
                        <StackPanel Spacing="0" Padding="24">
                            <TextBlock Text="Microsoft Windows" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock x:Name="VersionLineText" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="© Microsoft Corporation。保留所有权利。" FontSize="13" Margin="0,0,0,28"/>
                            <TextBlock x:Name="EditionText" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,28"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14">
                                根据 <Hyperlink NavigateUri="https://www.microsoft.com/zh-cn/legal/terms-of-use">Microsoft 软件许可条款</Hyperlink>，许可如下用户使用本产品:
                            </TextBlock>
                            <TextBlock x:Name="OwnerText" FontSize="13" Margin="24,0,0,4"/>
                            <TextBlock x:Name="OrgText" FontSize="13" Margin="24,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>